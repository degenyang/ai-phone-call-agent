# Copy to .env and fill in. Never commit .env.
# Load it before running locally, e.g.:  set -a; . ./.env; set +a

# --- shared by both sides ---
# Random secret used to sign each call's stream token. Must be identical in the local .env
# and the VPS .env. Generate with:  python3 -c "import secrets; print(secrets.token_hex(32))"
AICALL_SHARED_SECRET=replace_with_64_hex_chars
# Hard cap per call on the bridge. The driver refuses a --limit above it before placing the call,
# so keep the same value on both sides. Gemini calls are capped at 540 s whatever this says: a Gemini
# Live session lasts about 10 minutes and the bridge does not resume it.
AICALL_MAX_CALL_SECONDS=900

# --- local driver (aicall.py) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Preferred: a Twilio API key (SK...) and its secret instead of the account's master auth token.
# When TWILIO_API_KEY is set, the driver signs in with it and TWILIO_AUTH_TOKEN is not needed locally.
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# A Twilio-owned number (E.164). Default caller ID for +65 destinations (see README).
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# Optional: your own number verified as an outgoing caller ID in Twilio; default for other destinations.
TWILIO_VERIFIED_CALLER_ID=
# Public websocket URL that Twilio streams to (Caddy -> server.py)
PUBLIC_WSS_URL=wss://your-domain.example/media
# SFTP-only upload account for the per-call prompt/config and the results (docs/deployment.md, step 5)
AICALL_VPS_SSH=aicall-upload@your-domain.example
# The data directory as that account sees it: it is jailed in /srv/aicall, which looks like "/"
AICALL_REMOTE_DIR=/
# Local folder for call artifacts. "calls" is git-ignored; any other folder inside the repo must be
# added to .gitignore (aicall.py warns if it is not).
AICALL_OUT_DIR=calls
# Record audio by default (Twilio recording + bridge wavs). Off unless set to 1; --record/--no-record override.
AICALL_RECORD=0

# --- VPS bridge (server/server.py, via systemd EnvironmentFile) ---
# Data directory; calls live in AICALL_DIR/calls (the code stays in /opt/aicall)
AICALL_DIR=/srv/aicall
# Required: the bridge refuses to start without it (Gemini is the default model)
GEMINI_API_KEY=your_gemini_api_key
# Only needed for gpt-* realtime models
OPENAI_API_KEY=your_openai_api_key
# Calls with a model session at once (AICALL_MAX_CALL_SECONDS is set in the shared section above)
AICALL_MAX_CONCURRENT_CALLS=4
# Optional: also check X-Twilio-Signature on the websocket handshake (needs TWILIO_AUTH_TOKEN and
# PUBLIC_WSS_URL on the VPS). Off by default; try it with one test call before relying on it.
# Twilio signs with the account's master auth token, so enabling this puts that account-wide
# credential on the VPS (see docs/security.md).
AICALL_VERIFY_TWILIO_SIGNATURE=0
